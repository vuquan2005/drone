#!/usr/bin/env bash
# Git pre-commit hook: Auto-format staged files before committing.

set -e

# Get list of staged files (Added, Copied, Modified)
mapfile -d '' -t STAGED_FILES < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
    exit 0
fi

C_FILES=()
PRETTIER_FILES=()
CMAKE_FILES=()
LATEX_FILES=()

for FILE in "${STAGED_FILES[@]}"; do
    [ ! -f "$FILE" ] && continue

    case "$FILE" in
        # Skip CubeMX generated / vendor code and external repos
        firmware/drone/Core/*|firmware/drone/Drivers/*|docs/external/*|*/cmake/stm32cubemx/*|*build*/*)
            continue
            ;;

        *.c|*.h|*.cpp|*.hpp)
            C_FILES+=("$FILE")
            ;;

        *.md|*.json|*.jsonc|*.yaml|*.yml)
            PRETTIER_FILES+=("$FILE")
            ;;

        CMakeLists.txt|*.cmake)
            CMAKE_FILES+=("$FILE")
            ;;

        *.tex|*.sty|*.cls|*.bib)
            LATEX_FILES+=("$FILE")
            ;;
    esac
done

MODIFIED_FILES=()

# Format C/C++ in batch
if [ ${#C_FILES[@]} -gt 0 ] && command -v clang-format >/dev/null 2>&1; then
    clang-format -i "${C_FILES[@]}"
    MODIFIED_FILES+=("${C_FILES[@]}")
fi

# Format Markdown/JSON/YAML
if [ ${#PRETTIER_FILES[@]} -gt 0 ] && command -v prettier >/dev/null 2>&1; then
    prettier --write "${PRETTIER_FILES[@]}" >/dev/null 2>&1 || true
    MODIFIED_FILES+=("${PRETTIER_FILES[@]}")
fi

# Format CMake
if [ ${#CMAKE_FILES[@]} -gt 0 ] && command -v cmake-format >/dev/null 2>&1; then
    cmake-format -i "${CMAKE_FILES[@]}"
    MODIFIED_FILES+=("${CMAKE_FILES[@]}")
fi

# Format LaTeX sources and bibliography; keep backups/logs outside the repo.
if [ ${#LATEX_FILES[@]} -gt 0 ] && command -v latexindent >/dev/null 2>&1; then
    (
        LATEX_AUX_DIR=$(mktemp -d)
        trap 'rm -rf -- "$LATEX_AUX_DIR"' EXIT
        for FILE in "${LATEX_FILES[@]}"; do
            latexindent -w -s -c="$LATEX_AUX_DIR" "./$FILE"
        done
    )
    MODIFIED_FILES+=("${LATEX_FILES[@]}")
fi

# Re-stage any modified files
if [ ${#MODIFIED_FILES[@]} -gt 0 ]; then
    git add "${MODIFIED_FILES[@]}"
fi

exit 0
