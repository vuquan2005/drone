# Local reference repositories
/docs/external/repos/

# Local reference metadata, PDF sync state and extracted JPEG images
/docs/references/**/*.json
/docs/references/**/*.jpeg

# C/C++ and STM32 build outputs
build/
cmake-build-*/
Debug/
Release/
*.elf
*.bin
*.hex
*.map
*.o
*.a

# Local firmware toolchain overrides and generated editor databases
/firmware/**/CMakeUserPresets.json
/firmware/**/compile_commands.json
/firmware/**/.cache/clangd/
/firmware/**/.vscode/c_cpp_properties.json

# LaTeX temporary files (keep source documents and reference PDFs)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.bcf
*.run.xml
*.xdv

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Large or intermediate experiment data
/experiments/raw/*
/experiments/processed/*
!/experiments/raw/.gitkeep
!/experiments/processed/.gitkeep

# Local operating system files
.DS_Store
Thumbs.db

# KiCad local state, locks, automatic backups and recovery files
*.kicad_prl
*.kicad_pro.lck
*-backups/
_autosave-*
*.bak
*.bck
*.sch-bak
*.pcb-bak
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
**/.history/

# Temporary files and local version history
~$*
OldVersions/

# Runtime logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
