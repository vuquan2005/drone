{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Drone: ST-LINK GDB",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}/firmware/drone",
      "preLaunchTask": "firmware: build Debug",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/firmware/drone/build/Debug/drone.elf"
        }
      ],
      "serverInterface": "SWD",
      "serverInterfaceFrequency": "1000",
      "serverReset": "Software system reset",
      "serverRtos": {
        "enabled": false
      },
      "serverSemihosting": {
        "enabled": false
      },
      "logFile": "${workspaceFolder}/firmware/drone/build/Debug/gdb-client.log",
      "serverLogFile": "${workspaceFolder}/firmware/drone/build/Debug/stlink-gdbserver.log",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": "4"
      }
    },
    {
      "name": "Drone: OpenOCD + RTT",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/drone/build/Debug/drone.elf",
      "preLaunchTask": "firmware: build Debug + telemetry",
      "servertype": "openocd",
      "showDevDebugOutput": "raw",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "openOCDLaunchCommands": [
        "bindto 127.0.0.1",
        "adapter speed 1000",
        "reset_config none",
        "cortex_m reset_config sysresetreq"
      ],
      "postLaunchCommands": [
        "set {unsigned int}0xe000ed08 = 0x08000000",
        "set $sp = *(unsigned int *)0x08000000",
        "set $pc = (*(unsigned int *)0x08000004) & 0xfffffffe",
        "monitor stm32f1x.cpu configure -event halted { catch {rtt start} }",
        "monitor rtt server start 9090 0",
        "monitor rtt server start 9091 1"
      ],
      "postRestartCommands": [
        "set {unsigned int}0xe000ed08 = 0x08000000",
        "set $sp = *(unsigned int *)0x08000000",
        "set $pc = (*(unsigned int *)0x08000004) & 0xfffffffe"
      ],
      "runToEntryPoint": "app_process",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 20,
        "decoders": []
      }
    }
  ]
}
