{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Drone: ST-LINK GDB",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}/firmware/drone",
      "preLaunchTask": "firmware: build Debug",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/firmware/drone/build/Debug/drone.elf"
        }
      ],
      "serverInterface": "SWD",
      "serverInterfaceFrequency": "1000",
      "serverReset": "Software system reset",
      "serverRtos": {
        "enabled": false
      },
      "serverSemihosting": {
        "enabled": false
      },
      "logFile": "${workspaceFolder}/firmware/drone/build/Debug/gdb-client.log",
      "serverLogFile": "${workspaceFolder}/firmware/drone/build/Debug/stlink-gdbserver.log",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": "4"
      }
    },
    {
      "name": "Drone: OpenOCD + RTT",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/firmware/drone/build/Debug/drone.elf",
      "preLaunchTask": "firmware: build Debug + telemetry",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "openOCDLaunchCommands": [
        "bindto 127.0.0.1",
        "adapter speed 1000",
        "reset_config none",
        "cortex_m reset_config sysresetreq"
      ],
      "postLaunchCommands": [
        "monitor rtt server start 9090 0",
        "monitor rtt server start 9091 1"
      ],
      "runToEntryPoint": "app_process",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "rttConfig": {
        "enabled": true,
        "address": "auto",
        "polling_interval": 20,
        "rtt_start_retry": 1000,
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "label": "RTT LOG (CH0)",
            "inputmode": "disabled"
          }
        ]
      }
    }
  ]
}
