%%%%%%%%%%%%%%%%%%%%%% acronym support without glossaries %%%%%%%%%%%%%%%%%%%%
\newcommand{\acronymlist}{}
\newcommand{\acronymtype}{acronym}
\providecommand{\acronymname}{List of Abbreviations}
\newcommand{\setglossarystyle}[1]{}
\newcommand{\glsresetall}{}
\newcommand{\makeglossaries}{}
\newcommand{\glsadd}[1]{}
\newcommand{\newglossaryentry}[2]{}
\newcommand{\newacronym}[3]{%
  \expandafter\gdef\csname acro@#1@short\endcsname{#2}%
  \expandafter\gdef\csname acro@#1@long\endcsname{#3}%
  \listgadd{\acronymlist}{#1}%
}
\newcommand{\gls}[1]{%
  \ifcsdef{acro@#1@short}{\csname acro@#1@short\endcsname}{#1}%
}
\newcommand{\printacronymitem}[1]{%
  \textbf{\csname acro@#1@short\endcsname} & \csname acro@#1@long\endcsname \\
}
\newcommand{\printglossary}[1][]{%
  \begingroup
  \parindent=0pt
  \sloppy
  \raggedright
  \chapter*{\acronymname}%
  \normalsize
  \setlength{\tabcolsep}{0pt}%
  \begin{tabular}{@{}>{\raggedright\arraybackslash}p{3cm}@{\quad}>{\raggedright\arraybackslash}p{11cm}@{}}
  \forlistloop{\printacronymitem}{\acronymlist}
  \end{tabular}%
  \endgroup
}
%%%%%%%%%%%%%%%%%%%%%% acronym support without glossaries end %%%%%%%%%%%%%%%%

